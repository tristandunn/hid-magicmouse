From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tristan Dunn <hello@tristandunn.com>
Date: Thu, 27 Aug 2026 19:32:10 -0400
Subject: Prevent scrolling while a button is held.

Dragging with a button held frequently registers stray touch motion,
which turns a drag into an unwanted scroll. Extend the suppression added
for pointer movement to cover a held button.

Add scroll_while_clicking to restore the previous behavior.
---
 hid-magicmouse.c | 12 +++++++++---
 1 file changed, 9 insertions(+), 3 deletions(-)

diff --git a/hid-magicmouse.c b/hid-magicmouse.c
index 7b2fa30..60ff889 100644
--- a/hid-magicmouse.c
+++ b/hid-magicmouse.c
@@ -55,6 +55,10 @@ static bool scroll_while_moving = false;
 module_param(scroll_while_moving, bool, 0644);
 MODULE_PARM_DESC(scroll_while_moving, "Enable scrolling when the mouse is moving");
 
+static bool scroll_while_clicking = false;
+module_param(scroll_while_clicking, bool, 0644);
+MODULE_PARM_DESC(scroll_while_clicking, "Enable scrolling when a button is held");
+
 #define TRACKPAD2_2021_BT_VERSION 0x110
 #define TRACKPAD_2024_BT_VERSION 0x314
 
@@ -268,11 +272,12 @@ static void magicmouse_emit_touch(struct magicmouse_sc *msc, int raw_id, u8 *tda
 	msc->touches[id].size = size;
 
 	/* If requested, emulate a scroll wheel by detecting small
-	 * vertical touch motions. Skip when the mouse is moving, unless
-	 * scroll_while_moving is enabled.
+	 * vertical touch motions. Skip when the mouse is moving or a
+	 * button is held, unless the corresponding option is enabled.
 	 */
 	if (emulate_scroll_wheel &&
 	    (scroll_while_moving || !(msc->delta_x || msc->delta_y)) &&
+	    (scroll_while_clicking || !msc->button_down) &&
 	    input->id.product != USB_DEVICE_ID_APPLE_MAGICTRACKPAD2 &&
 	    input->id.product != USB_DEVICE_ID_APPLE_MAGICTRACKPAD2_USBC) {
 		unsigned long now = jiffies;
@@ -358,7 +363,8 @@ static void magicmouse_emit_touch(struct magicmouse_sc *msc, int raw_id, u8 *tda
 			break;
 		}
 	} else if (emulate_scroll_wheel &&
-		   !scroll_while_moving && (msc->delta_x || msc->delta_y)) {
+		   ((!scroll_while_moving && (msc->delta_x || msc->delta_y)) ||
+		    (!scroll_while_clicking && msc->button_down))) {
 		/* Reset scroll tracking when scrolling is suppressed to prevent jumps. */
 		msc->touches[id].scroll_x = x;
 		msc->touches[id].scroll_y = y;
